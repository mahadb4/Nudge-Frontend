# Copy to .env.local. Everything starting with VITE_ is compiled into the public bundle,
# so never put a secret, key or token here. Only the public address of the API.
#
# Real API is the default. Set to true to run the auth screens on the built-in mock, with no network calls.
VITE_USE_MOCK_API=false

# Dev only. Where the Vite dev server forwards /api/v1 (the Django dev server). The browser only ever
# talks to the Vite origin, so cookies stay on one origin. Not used by the production build, which needs
# a same-origin reverse proxy for /api/v1.
VITE_DEV_PROXY_TARGET=http://localhost:8000
